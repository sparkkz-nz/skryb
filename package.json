{
  "name": "skryb-runtime",
  "private": true,
  "version": "0.0.0",
  "description": "Skryb portable HTML document runtime",
  "license": "Apache-2.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:docs": "node scripts/build-reference.mjs",
    "bake": "node scripts/bake.mjs",
    "check": "tsc --noEmit",
    "check:artifacts": "node scripts/check-runtime-artifact-sizes.mjs",
    "benchmark:flowchart": "npm run build && node --test --test-name-pattern=\"500-node (flat|nested) flowchart lint\" test/lint.test.mjs",
    "lint": "node scripts/lint.mjs",
    "test": "npm run build && npm run build:docs && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
